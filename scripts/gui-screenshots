#!/usr/bin/env bash
# Capture the Tidy It GUI's whole results page, light and dark, as PNGs.
# Usage: scripts/gui-screenshots OUTDIR   (X11 session; needs xwd, ffmpeg)
# Build bin/tidyit-gui first. Closes any running tidyit-gui.
set -euo pipefail
out=${1:?usage: $0 OUTDIR}
cd "$(dirname "$0")/.."
pkill -x tidyit-gui || true
sleep 1
for scheme in light dark; do
	export ADW_DEBUG_COLOR_SCHEME=default
	[ "$scheme" = dark ] && export ADW_DEBUG_COLOR_SCHEME=prefer-dark
	TIDYIT_GUI_SCREENSHOTS="$out/$scheme" ./bin/tidyit-gui | while read -r kind path; do
		[ "$kind" = shot ] || continue
		# Raise the window (activating the app presents it), then grab it.
		gdbus call --session --dest com.inulty.TidyIt --object-path /com/inulty/TidyIt \
			--method org.freedesktop.Application.Activate '{}' >/dev/null
		sleep 0.3
		id=$(xwininfo -root -tree | awk '/"Tidy It( – [^"]*)?": \("tidyit-gui"/ {print $1; exit}')
		xwd -id "$id" -silent | ffmpeg -loglevel error -y -f xwd_pipe -i - "$path"
		echo "$path"
	done
done
